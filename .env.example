LANGAI_ENV=development
LANGAI_BIND=0.0.0.0:8080
DATABASE_URL=postgresql://langai:langai@postgres:5432/langai
POSTGRES_DB=langai
POSTGRES_USER=langai
POSTGRES_PASSWORD=change-this-local-password
RUST_LOG=langai_server=info,tower_http=info
SESSION_PEPPER=replace-with-at-least-32-random-characters
SECRETS_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes
AUDIO_STORAGE_PATH=./data/audio
MAX_AUDIO_BYTES=26214400
WEB_ROOT=./out
SESSION_TTL_SECONDS=2592000
REGISTRATION_MODE=open
